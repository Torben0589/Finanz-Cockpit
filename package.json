    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
