# =====================================================================
# Raspberry Pi 5 — Runtime Secrets (LOCAL ONLY)
#
# 1. Copy this file to ".env" in the SAME folder (deploy/pi/.env)
# 2. Fill in real values below
# 3. NEVER commit the resulting ".env" file — it is already covered by
#    the repo's root .gitignore, but double-check with:
#      git check-ignore -v deploy/pi/.env
# =====================================================================

# Generate with: openssl rand -hex 32
SESSION_SECRET=REPLACE_ME_WITH_RANDOM_64_CHAR_HEX

SESSION_TTL_MINUTES=60
PBKDF2_ITERATIONS=210000

# mock (offline, default) | csv | yahoo
PRICE_PROVIDER=mock
