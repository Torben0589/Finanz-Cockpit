# =====================================================================
# Finance Cockpit – Environment Configuration
# Copy this file to ".env" and adjust for your environment.
# =====================================================================

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
# Local mode (default) – single SQLite file:
DATABASE_URL="file:/data/finance.db"

# NAS mode (Fritz!NAS via SMB/WebDAV mount) – point DATABASE_PATH at the
# mounted network share. Example if your NAS share is mounted under
# /mnt/fritznas/finance:
# DATABASE_URL="file:/mnt/fritznas/finance/finance.db"

# Optional Docker/Postgres mode (see docker-compose.yml, "postgres" profile):
# DATABASE_URL="postgresql://finance:finance@postgres:5432/finance?schema=public"

# ---------------------------------------------------------------------
# Session / Cookie configuration
# ---------------------------------------------------------------------
# Random string used to sign the session cookie id. Generate with:
#   openssl rand -hex 32
SESSION_SECRET="change-me-to-a-random-64-char-hex-string"

# Session lifetime in minutes (key is kept only in server memory)
SESSION_TTL_MINUTES=60

# ---------------------------------------------------------------------
# Encryption
# ---------------------------------------------------------------------
# PBKDF2 iterations for master password key derivation.
# Increase on powerful hardware, decrease on weak NAS CPUs if login feels slow.
PBKDF2_ITERATIONS=210000

# ---------------------------------------------------------------------
# Market Data Provider
# ---------------------------------------------------------------------
# One of: mock | csv | yahoo
PRICE_PROVIDER=mock

# Only used when PRICE_PROVIDER=yahoo. Stored encrypted in DB after first
# entry via Settings page; this is only a fallback for first boot.
# YAHOO_API_KEY=

# ---------------------------------------------------------------------
# App
# ---------------------------------------------------------------------
NODE_ENV=development
PORT=3000
