// =====================================================================
// Finance Cockpit – Prisma Schema
// Default provider: SQLite (file-based, local-first, NAS-compatible)
// Switch "provider" below to "postgresql" for Docker/NAS multi-user mode.
// NOTE: SQLite has no native enum support in Prisma, so enum-like fields
// are modeled as validated Strings (see src/types/index.ts for the
// TypeScript union types and src/lib/validation for zod enforcement).
// =====================================================================

generator client {
  provider = "prisma-client-js"
  // "native" covers local dev on whatever machine runs `prisma generate`.
  // "linux-arm64-openssl-3.0.x" is required for the Raspberry Pi 5 image
  // built via GitHub Actions on an amd64 runner (cross-compilation) —
  // without this, the ARM64 container would ship an x86 Prisma engine
  // and crash on startup with "invalid ELF header".
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------
// User & Auth
// ---------------------------------------------------------------------
model User {
  id                String   @id @default(cuid())
  username          String   @unique
  // PBKDF2 password verifier (NOT the encryption key itself)
  passwordHash      String
  passwordSalt      String
  // Salt used to derive the AES-256 data-encryption key from the master
  // password. The derived key is NEVER persisted, only held in memory
  // for the lifetime of the session (see src/lib/session.ts).
  keySalt           String
  pbkdf2Iterations  Int      @default(210000)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  accounts     Account[]
  portfolios   Portfolio[]
  transactions Transaction[]
  categories   Category[]
  budgets      Budget[]
  settings     Setting[]
}

// ---------------------------------------------------------------------
// Accounts (cash / bank / broker cash positions)
// ---------------------------------------------------------------------
model Account {
  id                       String   @id @default(cuid())
  userId                   String
  name                     String
  // "CASH" | "BANK" | "BROKER" | "CREDIT_CARD" | "OTHER"
  type                     String   @default("BANK")
  currency                 String   @default("EUR")
  // AES-256-GCM encrypted account number / IBAN (base64 payload)
  accountNumberEncrypted   String?
  startingBalance          Float    @default(0)
  isArchived               Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

// ---------------------------------------------------------------------
// Portfolios & Holdings
// ---------------------------------------------------------------------
model Portfolio {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  holdings     Holding[]
  transactions Transaction[]
  dividends    Dividend[]

  @@index([userId])
}

model Asset {
  id       String  @id @default(cuid())
  symbol   String  @unique
  name     String
  // "STOCK" | "ETF" | "CRYPTO" | "FUND" | "BOND" | "OTHER"
  type     String  @default("STOCK")
  currency String  @default("EUR")

  holdings     Holding[]
  transactions Transaction[]
  priceHistory PriceHistory[]
  dividends    Dividend[]
}

model Holding {
  id               String   @id @default(cuid())
  portfolioId      String
  assetId          String
  quantity         Float    @default(0)
  averageBuyPrice  Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, assetId])
  @@index([portfolioId])
  @@index([assetId])
}

// ---------------------------------------------------------------------
// Transactions Ledger
// ---------------------------------------------------------------------
model Transaction {
  id            String   @id @default(cuid())
  userId        String
  accountId     String?
  portfolioId   String?
  assetId       String?
  categoryId    String?
  // "INCOME" | "EXPENSE" | "BUY" | "SELL" | "DIVIDEND"
  type          String
  amount        Float
  quantity      Float?
  price         Float?
  currency      String   @default("EUR")
  date          DateTime
  // AES-256-GCM encrypted free-text note (base64 payload)
  noteEncrypted String?
  importSource  String?  // e.g. "csv:sparkasse", "manual"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  account   Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  portfolio Portfolio? @relation(fields: [portfolioId], references: [id], onDelete: SetNull)
  asset     Asset?     @relation(fields: [assetId], references: [id], onDelete: SetNull)
  category  Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([accountId])
  @@index([portfolioId])
  @@index([categoryId])
}

// ---------------------------------------------------------------------
// Categories & Budgets
// ---------------------------------------------------------------------
model Category {
  id     String @id @default(cuid())
  userId String
  name   String
  // "INCOME" | "EXPENSE"
  type   String @default("EXPENSE")
  color  String @default("#3ddc97")
  icon   String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name])
  @@index([userId])
}

model Budget {
  id         String @id @default(cuid())
  userId     String
  categoryId String
  // "YYYY-MM" for a specific month, or "RECURRING" for a standing monthly budget
  month      String
  amount     Float

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month])
  @@index([userId, month])
}

// ---------------------------------------------------------------------
// Market Data
// ---------------------------------------------------------------------
model PriceHistory {
  id      String   @id @default(cuid())
  assetId String
  date    DateTime
  price   Float
  source  String   @default("mock") // "mock" | "csv" | "yahoo"

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, date])
  @@index([assetId, date])
}

// ---------------------------------------------------------------------
// Dividends
// ---------------------------------------------------------------------
model Dividend {
  id              String   @id @default(cuid())
  assetId         String
  portfolioId     String
  exDate          DateTime
  payDate         DateTime?
  amountPerShare  Float
  quantityAtPay   Float
  totalAmount     Float
  currency        String   @default("EUR")
  createdAt       DateTime @default(now())

  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@index([portfolioId])
}

// ---------------------------------------------------------------------
// Settings (encrypted key/value store, e.g. API tokens)
// ---------------------------------------------------------------------
model Setting {
  id               String @id @default(cuid())
  userId           String
  key              String
  // AES-256-GCM encrypted value (base64 payload). Plaintext keys like
  // "priceProvider" may be stored unencrypted via valuePlain instead.
  valueEncrypted   String?
  valuePlain       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}
